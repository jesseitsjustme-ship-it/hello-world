<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Flexbash Transcoded RX Diversity</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#0ea5e9',
                        secondary: '#0284c7',
                        accent: '#7c3aed',
                        dark: '#0f172a',
                        light: '#f8fafc'
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            color: #f8fafc;
        }
        .card-hover {
            transition: all 0.3s ease;
            transform: translateY(0);
        }
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        .pulse {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .gradient-text {
            background: linear-gradient(90deg, #0ea5e9, #7c3aed, #0ea5e9);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .grid-bg {
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(14, 165, 233, 0.1) 0%, transparent 20%),
                radial-gradient(circle at 90% 80%, rgba(124, 58, 237, 0.1) 0%, transparent 20%);
        }
    </style>
</head>
<body class="grid-bg">
    <!-- Navigation -->
    <nav class="bg-dark/80 backdrop-blur-md border-b border-gray-800 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center space-x-2">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-r from-primary to-accent flex items-center justify-center">
                        <i class="fas fa-bolt text-white text-xl"></i>
                    </div>
                    <span class="text-xl font-bold gradient-text">Flexbash</span>
                </div>
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <button onclick="scrollToSection('home')" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-800 transition">Home</button>
                        <button onclick="scrollToSection('features')" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-800 transition">Features</button>
                        <button onclick="scrollToSection('diversity')" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-800 transition">Diversity</button>
                        <button onclick="scrollToSection('contact')" class="px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-800 transition">Contact</button>
                    </div>
                </div>
                <div class="md:hidden">
                    <button id="mobile-menu-button" class="text-gray-400 hover:text-white focus:outline-none">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>
        <div id="mobile-menu" class="md:hidden hidden absolute w-full bg-dark/95 backdrop-blur-md">
            <div class="px-2 pt-2 pb-3 space-y-1">
                <button onclick="scrollToSection('home'); toggleMobileMenu()" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-800 w-full text-left">Home</button>
                <button onclick="scrollToSection('features'); toggleMobileMenu()" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-800 w-full text-left">Features</button>
                <button onclick="scrollToSection('diversity'); toggleMobileMenu()" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-800 w-full text-left">Diversity</button>
                <button onclick="scrollToSection('contact'); toggleMobileMenu()" class="block px-3 py-2 rounded-md text-base font-medium hover:bg-gray-800 w-full text-left">Contact</button>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="text-center">
                <h1 class="text-4xl md:text-6xl font-bold mb-6">
                    <span class="block">Flexbash Transcoded</span>
                    <span class="block mt-2 gradient-text">RX Diversity</span>
                </h1>
                <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-10">
                    Advanced signal processing technology for enhanced wireless communication performance through diversified reception techniques
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <button onclick="scrollToSection('features')" class="px-8 py-3 bg-gradient-to-r from-primary to-secondary rounded-lg font-semibold hover:from-primary/90 hover:to-secondary/90 transition-all transform hover:scale-105">
                        Explore Features
                    </button>
                    <button onclick="scrollToSection('diversity')" class="px-8 py-3 bg-transparent border-2 border-primary rounded-lg font-semibold hover:bg-primary/10 transition-all">
                        Learn More
                    </button>
                </div>
            </div>
            
            <!-- Stats Cards -->
            <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="card-hover bg-gray-900/50 backdrop-blur-sm p-6 rounded-xl border border-gray-800">
                    <div class="text-3xl font-bold text-primary mb-2">99.9%</div>
                    <div class="text-gray-300">Signal Reliability</div>
                </div>
                <div class="card-hover bg-gray-900/50 backdrop-blur-sm p-6 rounded-xl border border-gray-800">
                    <div class="text-3xl font-bold text-accent mb-2">40%</div>
                    <div class="text-gray-300">Signal Strength Improvement</div>
                </div>
                <div class="card-hover bg-gray-900/50 backdrop-blur-sm p-6 rounded-xl border border-gray-800">
                    <div class="text-3xl font-bold text-secondary mb-2">2x</div>
                    <div class="text-gray-300">Data Throughput Enhancement</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-20 px-4 sm:px-6 lg:px-8 bg-dark/30">
        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Core Features</h2>
                <p class="text-gray-400 max-w-2xl mx-auto">Advanced transcoding algorithms combined with sophisticated diversity techniques for optimal performance</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="card-hover bg-gray-900/50 backdrop-blur-sm p-8 rounded-xl border border-gray-800">
                    <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center mb-6">
                        <i class="fas fa-microchip text-primary text-xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Transcoding Efficiency</h3>
                    <p class="text-gray-400">Advanced compression and transcoding algorithms that maintain signal quality while reducing bandwidth consumption.</p>
                </div>
                
                <div class="card-hover bg-gray-900/50 backdrop-blur-sm p-8 rounded-xl border border-gray-800">
                    <div class="w-12 h-12 rounded-lg bg-accent/20 flex items-center justify-center mb-6">
                        <i class="fas fa-signal text-accent text-xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Signal Diversity</h3>
                    <p class="text-gray-400">Multiple reception paths and adaptive algorithms that enhance signal reliability in challenging environments.</p>
                </div>
                
                <div class="card-hover bg-gray-900/50 backdrop-blur-sm p-8 rounded-xl border border-gray-800">
                    <div class="w-12 h-12 rounded-lg bg-secondary/20 flex items-center justify-center mb-6">
                        <i class="fas fa-broadcast-tower text-secondary text-xl"></i>
                    </div>
                    <h3 class="text-xl font-semibold mb-3">Real-time Processing</h3>
                    <p class="text-gray-400">Low-latency processing capabilities that ensure seamless communication without compromising performance.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- RX Diversity Section -->
    <section id="diversity" class="py-20 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center gap-12">
                <div class="lg:w-1/2">
                    <h2 class="text-3xl md:text-4xl font-bold mb-6">RX Diversity Techniques</h2>
                    <p class="text-gray-300 mb-6">
                        The Flexbash Transcoded RX Diversity system employs advanced signal processing methods to optimize reception quality by leveraging multiple input channels.
                    </p>
                    <div class="space-y-4">
                        <div class="flex items-start">
                            <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center mt-1 mr-3 flex-shrink-0">
                                <i class="fas fa-check text-primary text-xs"></i>
                            </div>
                            <p class="text-gray-300">Spatial diversity combining multiple antenna arrays</p>
                        </div>
                        <div class="flex items-start">
                            <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center mt-1 mr-3 flex-shrink-0">
                                <i class="fas fa-check text-primary text-xs"></i>
                            </div>
                            <p class="text-gray-300">Frequency diversity across multiple channels</p>
                        </div>
                        <div class="flex items-start">
                            <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center mt-1 mr-3 flex-shrink-0">
                                <i class="fas fa-check text-primary text-xs"></i>
                            </div>
                            <p class="text-gray-300">Time diversity with adaptive switching algorithms</p>
                        </div>
                        <div class="flex items-start">
                            <div class="w-6 h-6 rounded-full bg-primary/20 flex items-center justify-center mt-1 mr-3 flex-shrink-0">
                                <i class="fas fa-check text-primary text-xs"></i>
                            </div>
                            <p class="text-gray-300">Smart signal selection based on channel conditions</p>
                        </div>
                    </div>
                    <button onclick="scrollToSection('contact')" class="mt-8 px-6 py-3 bg-gradient-to-r from-primary to-secondary rounded-lg font-semibold hover:from-primary/90 hover:to-secondary/90 transition-all">
                        Get Technical Details
                    </button>
                </div>
                <div class="lg:w-1/2">
                    <div class="relative">
                        <div class="bg-gray-900/50 backdrop-blur-sm rounded-xl border border-gray-800 p-6">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-semibold">Diversity Signal Analysis</h3>
                                <div class="flex space-x-2">
                                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                                    <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Signal Strength:</span>
                                    <span class="font-mono">-52 dBm</span>
                                </div>
                                <div class="w-full bg-gray-800 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-primary to-secondary h-2 rounded-full" style="width: 85%"></div>
                                </div>
                                
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">Interference:</span>
                                    <span class="font-mono">-68 dBm</span>
                                </div>
                                <div class="w-full bg-gray-800 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-primary to-secondary h-2 rounded-full" style="width: 25%"></div>
                                </div>
                                
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">SNR:</span>
                                    <span class="font-mono">24.5 dB</span>
                                </div>
                                <div class="w-full bg-gray-800 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-primary to-secondary h-2 rounded-full" style="width: 90%"></div>
                                </div>
                            </div>
                            
                            <div class="mt-6 p-4 bg-gray-800/50 rounded-lg">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm text-gray-400">Optimization Status</span>
                                    <span class="text-sm text-green-400">Active</span>
                                </div>
                                <div class="w-full bg-gray-700 rounded-full h-2">
                                    <div class="bg-gradient-to-r from-green-500 to-emerald-500 h-2 rounded-full animate-pulse" style="width: 75%"></div>
                                </div>
                                <div class="mt-3 text-xs text-gray-400">
                                    <p>Diversity combining algorithm: Maximal Ratio Combining</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20 px-4 sm:px-6 lg:px-8 bg-dark/30">
        <div class="max-w-4xl mx-auto">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Get In Touch</h2>
                <p class="text-gray-400 max-w-2xl mx-auto">Contact our engineering team for technical specifications and implementation details</p>
            </div>
            
            <div class="bg-gray-900/50 backdrop-blur-sm rounded-xl border border-gray-800 p-8">
                <form class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">Name</label>
                            <input type="text" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-2">Email</label>
                            <input type="email" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Subject</label>
                        <input type="text" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-2">Message</label>
                        <textarea rows="4" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"></textarea>
                    </div>
                    
                    <button type="submit" class="w-full px-6 py-3 bg-gradient-to-r from-primary to-secondary rounded-lg font-semibold hover:from-primary/90 hover:to-secondary/90 transition-all">
                        Send Message
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-gray-800 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="flex items-center space-x-2 mb-6 md:mb-0">
                    <div class="w-10 h-10 rounded-lg bg-gradient-to-r from-primary to-accent flex items-center justify-center">
                        <i class="fas fa-bolt text-white text-xl"></i>
                    </div>
                    <span class="text-xl font-bold gradient-text">Flexbash</span>
                </div>
                <div class="text-gray-400 text-sm">
                    &copy; 2023 Flexbash Transcoded RX Diversity. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <script>
        function scrollToSection(sectionId) {
            const section = document.getElementById(sectionId);
            if (section) {
                section.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function toggleMobileMenu() {
            const mobileMenu = document.getElementById('mobile-menu');
            mobileMenu.classList.toggle('hidden');
        }

        // Close mobile menu when clicking outside
        document.addEventListener('click', function(event) {
            const mobileMenuButton = document.getElementById('mobile-menu-button');
            const mobileMenu = document.getElementById('mobile-menu');
            
            if (!mobileMenuButton.contains(event.target) && !mobileMenu.contains(event.target)) {
                mobileMenu.classList.add('hidden');
            }
        });

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>
</body>
</html>